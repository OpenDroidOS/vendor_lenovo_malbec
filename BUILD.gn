import("//build/ohos.gni")

ohos_prebuilt_etc("product_parameters") {
  source = "product.para"
  relative_install_dir = "param"
  install_images = [ sys_prod_base_dir ]
  install_enable = true
  part_name = "product_malbec"
}

group("product") {
  deps = [
    ":product_parameters",
    "//vendor/opendroid/common:common",
  ]
}
